# Cluster-dispatch shapes, shared by hw/unittest run-cluster-dispatch and tests/unittest
# run-cluster-dispatch, as (GPCs, CPCs per GPC, TPCs per CPC, SMs per TPC): micro (2,1,1,2),
# nano (8,1,1,2), pocket (8,2,1,2), h100 (8,2,4,2), npB (4,4,1,2), cpc4 (1,2,2,1), and today's
# 2 clusters x 2 cores (degen, SPREAD policy).
CD_SHAPES := micro nano pocket h100 npB cpc4 degen
CD_H100 := -DVX_CFG_H100_ORG_ENABLE
CD_micro  := $(CD_H100) -DVX_CFG_NUM_PARTITIONS=2 -DVX_CFG_GPCS_PER_PARTITION=1 -DVX_CFG_CPCS_PER_GPC=1 -DVX_CFG_TPCS_PER_CPC=1 -DVX_CFG_SMS_PER_TPC=2
CD_nano   := $(CD_H100) -DVX_CFG_NUM_PARTITIONS=2 -DVX_CFG_GPCS_PER_PARTITION=4 -DVX_CFG_CPCS_PER_GPC=1 -DVX_CFG_TPCS_PER_CPC=1 -DVX_CFG_SMS_PER_TPC=2
CD_pocket := $(CD_H100) -DVX_CFG_NUM_PARTITIONS=2 -DVX_CFG_GPCS_PER_PARTITION=4 -DVX_CFG_CPCS_PER_GPC=2 -DVX_CFG_TPCS_PER_CPC=1 -DVX_CFG_SMS_PER_TPC=2
CD_h100   := $(CD_H100) -DVX_CFG_NUM_PARTITIONS=2 -DVX_CFG_GPCS_PER_PARTITION=4 -DVX_CFG_CPCS_PER_GPC=2 -DVX_CFG_TPCS_PER_CPC=4 -DVX_CFG_SMS_PER_TPC=2
CD_npB    := $(CD_H100) -DVX_CFG_NUM_PARTITIONS=2 -DVX_CFG_GPCS_PER_PARTITION=2 -DVX_CFG_CPCS_PER_GPC=4 -DVX_CFG_TPCS_PER_CPC=1 -DVX_CFG_SMS_PER_TPC=2
CD_cpc4   := $(CD_H100) -DVX_CFG_NUM_PARTITIONS=1 -DVX_CFG_GPCS_PER_PARTITION=1 -DVX_CFG_CPCS_PER_GPC=2 -DVX_CFG_TPCS_PER_CPC=2 -DVX_CFG_SMS_PER_TPC=1
CD_degen  := -DVX_CFG_NUM_CLUSTERS=2 -DVX_CFG_NUM_CORES=2
