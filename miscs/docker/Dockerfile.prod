# Use Ubuntu 22.04 as the base image. ci/install_dependencies.sh pulls
# jammy-native packages (libffi8, libpython3.10, the jammy Vulkan SDK repo),
# so the base must match the 22.04 CI image.
FROM ubuntu:22.04

# Set non-interactive installation to avoid user input during build
ARG DEBIAN_FRONTEND=noninteractive

# Install necessary dependencies and upgrade installed components
# Update and install necessary dependencies
RUN apt-get update && apt-get install -y \
    software-properties-common \
    build-essential \
    python3 \
    git \
    wget \
    curl \
    ca-certificates \
    sudo && \
    rm -rf /var/lib/apt/lists/*

# upgrade installed components
RUN apt-get upgrade && apt-get update

# temporary until remote dependency script gets updated
RUN apt-get install -y cmake

# Clone the Vortex repository
RUN git clone --depth=1 --recursive https://github.com/vortexgpgpu/vortex.git /vortex

# Set the initial working directory
WORKDIR /vortex

# Toolchain install location. Must be set before configure so it is baked
# into config.mk (VERILATOR_PATH ?= $(TOOLDIR)/verilator) and matched by the
# toolchain install below; config.mk uses ?= so this env value is also what
# `make` resolves at runtime.
ENV TOOLDIR=/opt

# install system dependencies (--all: baseline + vulkan loader/glslc + gem5
# runtime libs + OpenMPI, matching the CI image so every test suite runs)
RUN ./ci/install_dependencies.sh --all

# Configure the build folder
RUN mkdir build && cd build && ../configure --tooldir=$TOOLDIR

# Install prebuilt toolchain into $TOOLDIR
RUN cd build && ./ci/toolchain_install.sh --all

# Build SST + OpenMPI from source (not part of the prebuilt toolchain).
# Needs sudo (installed above) since sst_install.sh installs its build deps
# via `sudo apt` under `set -e`.
RUN cd build && ./ci/sst_install.sh

# Tool homes consumed by the run scripts (gem5_run_app.py uses $GEM5_HOME;
# sst_run_*.py use $SST_CORE_HOME / $SST_ELEMENTS_HOME).
ENV GEM5_HOME=$TOOLDIR/gem5
ENV MPIHOME=$TOOLDIR/openmpi_install
ENV SST_CORE_HOME=$TOOLDIR/sst-install/sst-core
ENV SST_ELEMENTS_HOME=$TOOLDIR/sst-install/sst-elements

# No shell env sourcing required: the Vortex Makefiles invoke every
# tool by absolute path baked at configure time. For interactive use
# (verilator, hipcc, vulkaninfo, sv2v, yosys, sst, mpirun), the TOOLDIR
# layout is on $PATH:
ENV PATH=$TOOLDIR/verilator/bin:$TOOLDIR/llvm-vortex/bin:$TOOLDIR/chipstar/bin:$TOOLDIR/pocl/bin:$TOOLDIR/mesa-vortex/bin:$TOOLDIR/sv2v/bin:$TOOLDIR/yosys/bin:$TOOLDIR/sta/bin:$TOOLDIR/riscv32-gnu-toolchain/bin:$TOOLDIR/riscv64-gnu-toolchain/bin:$MPIHOME/bin:$SST_CORE_HOME/bin:$SST_ELEMENTS_HOME/bin:$PATH
ENV LD_LIBRARY_PATH=$TOOLDIR/llvm-vortex/lib:$TOOLDIR/mesa-vortex/lib:$MPIHOME/lib:$SST_CORE_HOME/lib:$LD_LIBRARY_PATH
ENV VK_ICD_FILENAMES=$TOOLDIR/mesa-vortex/share/vulkan/icd.d/lvp_icd.x86_64.json

# Set the working directory to /vortex/build
WORKDIR /vortex/build
